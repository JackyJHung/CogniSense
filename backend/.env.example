# CogniSense configuration.
#
# Copy to .env and edit. .env is gitignored; this template is not, so never put
# a real secret in THIS file.
#
# Nothing here is required for local development -- every default is tuned for
# http://localhost. The settings that matter are the ones marked PRODUCTION,
# and the server refuses to start without them once COGNISENSE_ENV=production.
#
#   pip install python-dotenv
#   uvicorn app.main:app --env-file .env
#
# (uvicorn reads --env-file natively; the package is only needed if you want to
# load it from Python instead.)


# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "development" (default) or "production".
# Setting production turns on Secure cookies by default AND makes the startup
# check fatal rather than advisory.
COGNISENSE_ENV=development


# ---------------------------------------------------------------------------
# PRODUCTION: cookies and origins
# ---------------------------------------------------------------------------
# Session cookies are marked Secure, so the browser only sends them over HTTPS.
# Defaults to on when COGNISENSE_ENV=production. Leave it off for plain-http
# local development or the cookie is silently dropped and nothing logs in.
#COGNISENSE_COOKIE_SECURE=1

# Exact origin(s) the app is served from, comma separated, no trailing slash.
# Used for both CORS and the CSRF Origin check.
#
# In production this must NOT contain localhost or any http:// entry -- the
# startup check rejects both. There is normally exactly one value here, because
# the frontend is served from the same origin as the API.
#COGNISENSE_ALLOWED_ORIGINS=https://cognisense.example


# ---------------------------------------------------------------------------
# PRODUCTION: reverse proxy
# ---------------------------------------------------------------------------
# Addresses of proxies whose X-Forwarded-For header may be believed, comma
# separated. This is the address the proxy connects FROM, not the address it
# listens on -- for nginx on the same host, that is 127.0.0.1.
#
# EMPTY BY DEFAULT, and empty is the safe setting: with nothing listed the
# header is ignored entirely and the socket peer is used. Do not set this
# unless a proxy really is in front, because any client can send an arbitrary
# X-Forwarded-For and would otherwise get a fresh rate-limit budget per request.
#
# The proxy must also STRIP inbound X-Forwarded-For, or a client can prepend a
# forged entry that the proxy then appends to.
#COGNISENSE_TRUSTED_PROXIES=127.0.0.1


# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Absolute cap, in days. Even a session in constant use re-authenticates
# eventually.
#COGNISENSE_SESSION_TTL_DAYS=90

# Idle lifetime, and the one that binds in practice: a session untouched for
# this long expires even though the absolute cap has not run out.
#
# The default is 30, not the more usual 7, and that is deliberate. CogniSense's
# users are tracking cognitive decline; someone who misses a week is precisely
# the person least able to recall a password on being logged out. Thirty days
# lets somebody miss a month -- illness, a hospital stay -- and return to a
# working session.
#
# MUST be below SESSION_TTL_DAYS, or the absolute cap expires the session first
# and idle expiry never fires. Startup rejects that combination.
#COGNISENSE_SESSION_IDLE_DAYS=30


# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------
# Contact address embedded in the VAPID token, so a push service can reach
# whoever runs this server. The startup check rejects the placeholder in
# production.
#COGNISENSE_VAPID_SUBJECT=mailto:you@example.com

# How often the reminder scheduler looks for due reminders, in seconds.
#COGNISENSE_PUSH_TICK_SECONDS=60

# Minimum gap between reminder pushes to one user, in hours. Eight gives about
# two prompts across a waking day, matching the morning/midday/evening rhythm
# the check-in flow already assumes; six gives three or four and reads as
# nagging. A reminder app people mute is worse than one that asks less often.
#COGNISENSE_PUSH_COOLDOWN_HOURS=8

# Set to 1 to stop the reminder loop entirely. The test suite sets this.
#COGNISENSE_DISABLE_SCHEDULER=1


# ---------------------------------------------------------------------------
# Email (optional — enables "email me a reset link")
# ---------------------------------------------------------------------------
# With NO SMTP host set, the app still works: confirmation and reset links are
# written to the server log instead of sent, and the UI says so rather than
# telling somebody to check an inbox that will stay empty. Recovery codes work
# either way.
#
# PUBLIC_URL is the absolute base the app is reached at, and links inside
# emails are built from it. A localhost value mails a dead link, so production
# rejects one.
#COGNISENSE_PUBLIC_URL=https://cognisense.example

#COGNISENSE_SMTP_HOST=smtp.example.com
#COGNISENSE_SMTP_PORT=587
#COGNISENSE_SMTP_USER=apikey-or-username
#COGNISENSE_SMTP_PASSWORD=put-the-real-secret-in-.env-not-here
# STARTTLS on 587 (the usual), implicit TLS on 465. Never turn this off.
#COGNISENSE_SMTP_STARTTLS=1
# Must be a real, deliverable sender or most providers reject or spam-file it.
#COGNISENSE_SMTP_FROM=CogniSense <no-reply@cognisense.example>

# How long emailed links stay usable.
#COGNISENSE_RESET_TOKEN_MINUTES=60
#COGNISENSE_VERIFY_TOKEN_HOURS=24


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG surfaces each scheduler decision; INFO is the default.
#COGNISENSE_LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# NOT configured here
# ---------------------------------------------------------------------------
# The VAPID keypair is generated on first run at backend/app/db/vapid_private.pem
# and must persist. Regenerating it invalidates every existing push
# subscription, because browsers pin the applicationServerKey they subscribed
# with. Back it up with the database; never commit it.
