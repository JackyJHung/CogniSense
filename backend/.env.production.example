# CogniSense production configuration.
#
# Copy to .env on the server, then replace EVERY occurrence of
# cognisense.example with your real domain. That substitution is the only edit
# required to make this file valid -- everything else is either already correct
# or optional.
#
#   cp .env.production.example .env
#   sed -i 's/cognisense.example/yourdomain.tld/g' .env      # then check it
#   uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000
#
# The server REFUSES TO START if any of the required values below is wrong, so a
# half-finished copy of this file fails loudly at boot rather than serving
# something insecure. Everything commented out is optional.
#
# Do not commit the resulting .env -- it is gitignored, and it will hold the
# SMTP password.


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
COGNISENSE_ENV=production

# The single origin the app is served from. Frontend and API share it: the
# backend serves web_app/dist itself, which is what lets the session cookie be
# SameSite=Strict. Two entries here almost always means something is wrong.
COGNISENSE_ALLOWED_ORIGINS=https://cognisense.example

# Absolute base URL, used to build links inside emails. Same value.
COGNISENSE_PUBLIC_URL=https://cognisense.example

# Contact address embedded in push tokens, so a push service can reach whoever
# runs the server. Any address that reaches you.
COGNISENSE_VAPID_SUBJECT=mailto:you@cognisense.example

# COOKIE_SECURE is intentionally absent: it defaults ON in production. Setting
# it to 0 here would be the one way to silently ship insecure cookies.


# ---------------------------------------------------------------------------
# Reverse proxy — set ONLY if one is actually in front
# ---------------------------------------------------------------------------
# The address the proxy connects FROM. 127.0.0.1 for nginx or Caddy on the same
# host. Leave commented out if uvicorn is exposed directly: with nothing listed,
# X-Forwarded-For is ignored entirely, which is the safe behaviour.
#
# The proxy MUST also strip inbound X-Forwarded-For, or a client can prepend a
# forged entry and sidestep the per-IP rate limit.
#COGNISENSE_TRUSTED_PROXIES=127.0.0.1


# ---------------------------------------------------------------------------
# Email — optional; recovery codes work without it
# ---------------------------------------------------------------------------
# Leave this whole block commented out until you have a domain whose mail is
# actually deliverable. With no SMTP host the app writes emails to the log and
# the UI says so, which is honest; half-configured mail that silently vanishes
# is not.
#
# Prefer a transactional provider (Resend, Postmark, SES) on a domain you
# control. Personal Gmail works for a single user but has low sending limits and
# poor deliverability to strangers.
#COGNISENSE_SMTP_HOST=smtp.resend.com
#COGNISENSE_SMTP_PORT=587
#COGNISENSE_SMTP_USER=resend
#COGNISENSE_SMTP_PASSWORD=
#COGNISENSE_SMTP_STARTTLS=1
#COGNISENSE_SMTP_FROM=CogniSense <no-reply@cognisense.example>


# ---------------------------------------------------------------------------
# Tuned for this app — uncomment only to override
# ---------------------------------------------------------------------------
# The shipped defaults are already the recommended values and are chosen for
# CogniSense's users specifically, not copied from a generic template:
#
#   SESSION_IDLE_DAYS=30   a user who misses a month still comes back to a
#                          working session; 7 would log out exactly the people
#                          least able to recall a password
#   SESSION_TTL_DAYS=90    absolute backstop above the idle window
#   PUSH_COOLDOWN_HOURS=8  about two prompts a day rather than three or four
#
#COGNISENSE_SESSION_IDLE_DAYS=30
#COGNISENSE_SESSION_TTL_DAYS=90
#COGNISENSE_PUSH_COOLDOWN_HOURS=8
#COGNISENSE_LOG_LEVEL=INFO
