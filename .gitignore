# ---------------------------------------------------------------------------
# CogniSense .gitignore
# Goal: keep PII (users, voice recordings, photos), credentials, and large
# build artifacts OUT of the public repo.
# ---------------------------------------------------------------------------

# === User data / PII (NEVER commit) =========================================
# SQLite DB holds usernames, demographics, and bcrypt password hashes.
backend/db/
**/cognisense.db
**/cognisense.db-journal
**/cognisense.db-wal
**/cognisense.db-shm

# The runtime data directory the app actually writes to. NOTE: this is
# backend/app/db/, which is a DIFFERENT path from backend/db/ above -- the
# rules above do not cover it. Audio was caught only by the `**/audio/` glob
# below, and reminder photos would not have been caught by anything.
backend/app/db/

# Voice recordings, profile pictures, and memory-test photos uploaded by users.
# Reminder photos (backend/app/db/reminders/) are pictures of a person's own
# home and errands, as identifying as the voice clips -- they are covered by the
# backend/app/db/ rule above rather than a `**/reminders/` glob, which would
# also silently swallow any future source directory of that name.
**/audio/
**/profile_pictures/
**/morning_photos/
**/user_photos/

# === Secrets / credentials ==================================================
.env
.env.*
# Templates are documentation and carry no secrets, so they are un-ignored.
# The second pattern is needed for names like .env.production.example -- the
# first only matches the exact name .env.example and would otherwise hide them.
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json

# === Python =================================================================
# Virtual environments
.venv/
venv/
env/
ENV/
**/.venv/

# Bytecode + caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build / dist
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# === ML artifacts ===========================================================
# Checkpoints are regenerated by `python -m app.ml.train_models`.
# Remove this line if you intend to ship pre-trained weights.
backend/app/ml/checkpoints/

# Validation reports. Every `python -m app.ml.validate` run writes a new
# timestamped .md/.json pair, so committing them accumulates churn with no
# review value. Regenerate instead. Commit a specific report deliberately with
# `git add -f` if you want to pin one to a claim you are making.
backend/results/

# === Node / React (web_app + mobile_app) ====================================
node_modules/
web_app/node_modules/
web_app/dist/
web_app/.vite/
mobile_app/node_modules/
mobile_app/android/build/
mobile_app/android/app/build/
mobile_app/ios/build/
mobile_app/ios/Pods/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite-generated env files (anything user-specific)
web_app/.env.local
web_app/.env.*.local

# === IDE / editor ===========================================================
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# === OS noise ===============================================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
